{
  "name": "xapian-msvc",
  "version": "2.1.0",
  "description": "Xapian search engine library — CMake/MSVC-friendly port (core + letor).",
  "homepage": "https://github.com/bendemott/xapian-msvc",
  "license": "GPL-2.0-or-later",
  "supports": "windows & !uwp & !xbox & (x64 | x86 | arm64)",
  "dependencies": [
    {
      "name": "vcpkg-cmake",
      "host": true
    },
    {
      "name": "vcpkg-cmake-config",
      "host": true
    },
    "zlib"
  ],
  "features": {
    "tools": {
      "description": "Build core CLI tools (delve, compact, check, …)"
    },
    "letor": {
      "description": "Build xapian-letor (learning to rank)",
      "dependencies": []
    },
    "omega": {
      "description": "Build xapian-omega (omindex, scriptindex, omega CGI)",
      "dependencies": [
        "pcre2"
      ]
    }
  },
  "default-features": [
    "letor",
    "tools"
  ]
}
